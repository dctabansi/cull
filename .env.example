# Server Configuration
CULL_HOST=127.0.0.1
CULL_PORT=8000
CULL_ENV=development
CULL_UPLOAD_DIR=./.cull_data/uploads

# PostgreSQL (Audit Logs & Transformation Recipes)
POSTGRES_USER=cull_user
POSTGRES_PASSWORD=cull_local_dev_password
POSTGRES_DB=cull_workbench
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cull_user:cull_local_dev_password@localhost:5432/cull_workbench

# Valkey (Job State & Schema Profile Cache)
VALKEY_URL=valkey://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
